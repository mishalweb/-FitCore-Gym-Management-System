<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.fitcore.controller.LoginController"
      alignment="CENTER" styleClass="login-root" spacing="0">
    <VBox alignment="CENTER_LEFT" prefWidth="470" maxWidth="470" spacing="20" styleClass="login-brand">
        <padding><Insets top="52" right="58" bottom="52" left="58"/></padding>
        <Label text="FITCORE" styleClass="brand-large"/>
        <Label text="STRENGTH · DISCIPLINE · PROGRESS" styleClass="eyebrow"/>
        <Region prefHeight="55"/>
        <Label text="Manage your gym.
Own your progress." wrapText="true" styleClass="hero-text"/>
        <Label text="Members, memberships, trainers, attendance and payments—all in one place." wrapText="true" styleClass="muted-lg"/>
        <Region prefHeight="42"/>
        <Label text="BUILT WITH JAVA 21  ·  JAVAFX  ·  MYSQL" styleClass="eyebrow"/>
    </VBox>
    <VBox alignment="CENTER_LEFT" prefWidth="420" maxWidth="420" spacing="17" styleClass="login-card">
        <padding><Insets top="52" right="48" bottom="52" left="48"/></padding>
        <Label text="ADMIN ACCESS" styleClass="eyebrow"/>
        <Label text="Welcome back" styleClass="headline"/>
        <Label text="Sign in to the FitCore management desk." styleClass="muted"/>
        <Region prefHeight="18"/>
        <Label text="Email address" styleClass="field-label"/>
        <TextField fx:id="emailField" promptText="admin@example.com" onAction="#login"/>
        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Your password" onAction="#login"/>
        <Region prefHeight="8"/>
        <Button text="SIGN IN" onAction="#login" maxWidth="Infinity" styleClass="primary-button"/>
        <Label fx:id="feedbackLabel" wrapText="true" styleClass="error-label"/>
        <Label text="To create your first administrator, follow README.md → Admin setup." wrapText="true" styleClass="tiny-note"/>
    </VBox>
</HBox>
